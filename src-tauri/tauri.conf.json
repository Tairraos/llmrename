{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Rename",
  "version": "0.1.9",
  "identifier": "com.llmrename.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Rename — 视觉模型批量重命名",
        "width": 900,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "用视觉模型按模板批量重命名图片",
    "longDescription": "llmrename 是一个桌面工具：配置重命名模板，用视觉模型解析图片并提取要素，按模板批量重命名资产库中的图片，全程记录 JSONL 日志。"
  }
}
